server {
    listen 80;
    server_name DOMAIN_PLACEHOLDER;

    # nginx's own default covers text/html and nothing else, so the sitemap, the
    # product feeds, robots.txt, llms.txt and the admin bundle would travel
    # uncompressed. Photos stay out: JPEG and WebP are already compressed.
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    # Everything here arrives through proxy_pass, and nginx does not compress a
    # proxied response unless told to: without this line the whole block is dead.
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/xml application/json
               application/javascript image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:9097;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Import and photo progress is SSE (/api/job/stream) and lives for
        # minutes; on HTTP/1.0 nginx closes the upstream early.
        proxy_http_version 1.1;
    }

    client_max_body_size 12m;
}
